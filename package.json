{
  "name": "lecturer-teaching-companion-system",
  "version": "1.0.0",
  "description": "A full-stack application to help university lecturers manage teaching records and reminders.",
  "type": "module",
  "main": "src/backend/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon src/backend/index.js",
    "client": "vite --config src/frontend/vite.config.js",
    "build": "vite build",
    "test": "vitest",
    "lint": "eslint . --ext .js,.jsx"
  },
  "keywords": [
    "education",
    "lecturer",
    "management",
    "teaching-assistant"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.3",
    "eslint": "^10.7.0",
    "nodemon": "^3.1.14",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
